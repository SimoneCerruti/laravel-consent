{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "simonecerruti/laravel-consent",
    "description": "Cookie consent banner, consent-gated scripts, proof of consent and GDPR tooling for Laravel",
    "keywords": [
        "laravel",
        "simonecerruti",
        "laravel-consent"
    ],
    "homepage": "https://github.com/simonecerruti/laravel-consent",
    "license": "MIT",
    "authors": [
        {
            "name": "Simone Cerruti",
            "email": "cerrutisimo@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0||^13.0",
        "spatie/laravel-data": "^4.23",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-phpstan": "^5.3",
        "pestphp/pest-plugin-rector": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.8",
        "thecodingmachine/phpstan-safe-rule": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SimoneCerruti\\Consent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimoneCerruti\\Consent\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "pint": [
            "vendor/bin/pint --parallel"
        ],
        "pint:dry": [
            "vendor/bin/pint --parallel --test"
        ],
        "rector": [
            "vendor/bin/rector"
        ],
        "rector:dry": [
            "vendor/bin/rector --dry-run"
        ],
        "stan": [
            "vendor/bin/phpstan analyse"
        ],
        "coverage": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test": [
            "vendor/bin/pest --parallel"
        ],
        "qa": [
            "@stan",
            "@rector:dry",
            "@pint:dry",
            "@coverage",
            "@test"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SimoneCerruti\\Consent\\ConsentServiceProvider"
            ],
            "aliases": {
                "Consent": "SimoneCerruti\\Consent\\Facades\\Consent"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
